{
  "name": "mcutrace-requirements",
  "displayName": "mcutrace Requirements",
  "description": "Language-server-powered requirement and traceability support for mcutrace.",
  "version": "0.2.4",
  "publisher": "mcutrace",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/frankonstone/mcutrace.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Requirement browsing remains available, but agent integration is disabled until the workspace is trusted.",
      "restrictedConfigurations": [
        "mcutrace.agent.mcp.path",
        "mcutrace.agent.mcp.arguments",
        "mcutrace.agent.mcp.configPath"
      ]
    }
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "requirements",
    "traceability",
    "mcutrace"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:mcutrace.refreshRequirements",
    "onView:mcutrace.traceView"
  ],
  "contributes": {
    "chatSkills": [
      {
        "path": "./skills/mcutrace/SKILL.md",
        "when": "mcutrace.agent.skillAvailable"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "mcutrace.agent.mcp",
        "label": "mcutrace",
        "when": "mcutrace.agent.mcpAvailable"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "mcutrace",
          "title": "mcutrace",
          "icon": "media/trace.svg"
        }
      ]
    },
    "views": {
      "mcutrace": [
        {
          "id": "mcutrace.traceView",
          "name": "Trace"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "mcutrace.refreshRequirements",
          "when": "view == mcutrace.traceView",
          "group": "navigation"
        },
        {
          "command": "mcutrace.findRequirement",
          "when": "view == mcutrace.traceView",
          "group": "navigation"
        },
        {
          "command": "mcutrace.revealActiveRequirement",
          "when": "view == mcutrace.traceView",
          "group": "1_navigation"
        },
        {
          "command": "mcutrace.showTraceProblems",
          "when": "view == mcutrace.traceView && !mcutrace.traceProblemsOnly",
          "group": "navigation"
        },
        {
          "command": "mcutrace.showAllTraceItems",
          "when": "view == mcutrace.traceView && mcutrace.traceProblemsOnly",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "mcutrace.refreshRequirements",
        "title": "mcutrace: Refresh Requirements",
        "icon": "$(refresh)"
      },
      {
        "command": "mcutrace.openTraceLocation",
        "title": "mcutrace: Open Trace Location"
      },
      {
        "command": "mcutrace.openTestLocation",
        "title": "mcutrace: Open Test Declaration"
      },
      {
        "command": "mcutrace.findRequirement",
        "title": "mcutrace: Find Requirement",
        "icon": "$(search)"
      },
      {
        "command": "mcutrace.revealActiveRequirement",
        "title": "mcutrace: Reveal Active Requirement",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mcutrace.showTraceProblems",
        "title": "mcutrace: Show Trace Problems Only",
        "icon": "$(filter)"
      },
      {
        "command": "mcutrace.showAllTraceItems",
        "title": "mcutrace: Show All Trace Items",
        "icon": "$(filter-filled)"
      },
      {
        "command": "mcutrace.showAgentIntegrationStatus",
        "title": "mcutrace: Show Agent Integration Status",
        "icon": "$(server-process)"
      },
      {
        "command": "mcutrace.setupCodex",
        "title": "mcutrace: Set Up Codex in Workspace",
        "icon": "$(cloud-download)"
      }
    ],
    "configuration": {
      "title": "mcutrace",
      "properties": {
        "mcutrace.languageServer.path": {
          "type": "string",
          "default": "",
          "description": "Optional path or command used instead of the bundled mcutrace language server. `${workspaceFolder}` is supported."
        },
        "mcutrace.languageServer.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments passed to the mcutrace language server. `${workspaceFolder}` is supported."
        },
        "mcutrace.agent.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Enable mcutrace agent integration for this workspace folder."
        },
        "mcutrace.agent.skill.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Contribute the bundled mcutrace Agent Skill for this workspace folder."
        },
        "mcutrace.agent.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Provide the mcutrace MCP server for this workspace folder."
        },
        "mcutrace.agent.mcp.path": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional path to mcutrace-mcp. Relative paths and `${workspaceFolder}` are resolved per workspace folder."
        },
        "mcutrace.agent.mcp.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "description": "Additional arguments passed directly to mcutrace-mcp. `${workspaceFolder}` is supported."
        },
        "mcutrace.agent.mcp.configPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional mcutrace configuration path. Defaults to mcutrace.toml in each workspace folder; relative paths and `${workspaceFolder}` are supported."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "scripts": {
    "stage-runtime": "node scripts/stage-server.js",
    "stage-server": "node scripts/stage-server.js",
    "test": "node --test test/*.test.js"
  }
}
